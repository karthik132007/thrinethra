FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 ffmpeg && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml requirements.lock ./
COPY apps/backend apps/backend
COPY packages packages
COPY demo demo
COPY scripts scripts
COPY configs configs
COPY infrastructure infrastructure
RUN pip install --no-cache-dir -c requirements.lock torch torchvision --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -c requirements.lock '.[vision,postgres]'
ENV API_HOST=0.0.0.0 PYTHONUNBUFFERED=1 YOLO_CONFIG_DIR=/tmp/trinethra-yolo
EXPOSE 8000
CMD ["python","scripts/run_backend.py"]
